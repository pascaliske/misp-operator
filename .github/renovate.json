{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["pascaliske/renovate-config"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Process various dependencies via comment lines",
      "managerFilePatterns": ["/.+\\.ya?ml$/", "/.+\\.go$/"],
      "datasourceTemplate": "{{#if datasource}}{{{datasource}}}{{else}}docker{{/if}}",
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}",
      "matchStrings": [
        "datasource=(?<datasource>\\S+) image=(?<packageName>\\S+)(?: versioning=(?<versioning>\\S+))?[^\"]*\"[^:]+:(?<currentValue>[^@\"]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?\""
      ]
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["gomod"],
      "postUpdateOptions": ["gomodTidy"]
    },
    {
      "matchPackageNames": ["/misp\/misp-docker/"],
      "groupName": "misp-docker",
      "sourceUrl": "https://github.com/misp/misp-docker"
    }
  ]
}

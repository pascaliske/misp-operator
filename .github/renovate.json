{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["pascaliske/renovate-config"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Process various dependencies via comment lines",
      "managerFilePatterns": ["/.+\\.ya?ml$/", "/.+\\.go$/"],
      "datasourceTemplate": "{{#if datasource}}{{{datasource}}}{{else}}docker{{/if}}",
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}",
      "matchStrings": [
        "datasource=(?<datasource>\\S+) image=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?(?<annotation> \\(\\d\\))?\n.*?[\"'](?<currentValue>\\S+)[\"']\n?"
      ]
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["gomod"],
      "postUpdateOptions": ["gomodTidy"]
    }
  ]
}
